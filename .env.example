# TTS provider selection
# Auto: complete local VoxCPM2/ASR -> local; otherwise Edge (no local models required).
SHORT_VIDEO_TTS_PROVIDER=auto
# Explicit alternatives: voxcpm2, edge, volcengine, local (macOS say), http, none

# Microsoft Edge online TTS, no API key required
EDGE_TTS_VOICE=<voice-name>
EDGE_TTS_LANG=<language-code>
EDGE_TTS_RATE=<rate>
EDGE_TTS_PITCH=<pitch>
EDGE_TTS_VOLUME=<volume>
EDGE_TTS_TIMEOUT=<milliseconds>
EDGE_TTS_PROXY=

# Final offline macOS fallback: omit voice/rate for system defaults; Chinese uses an installed Chinese voice
# MACOS_TTS_VOICE=Tingting
# MACOS_TTS_RATE=185

# Volcengine / ByteDance TTS
VOLCENGINE_TTS_APPID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_CLUSTER=<cluster>
VOLCENGINE_TTS_VOICE_TYPE=
VOLCENGINE_TTS_PRESET=<preset-id>
VOLCENGINE_TTS_SPEED_RATIO=<speed-ratio>
VOLCENGINE_TTS_LOUDNESS_RATIO=<loudness-ratio>
VOLCENGINE_TTS_MODEL=<model-name>

# Generic HTTP TTS adapter
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_API_AUTH_TYPE=<bearer|header|none>
TTS_API_KEY_HEADER=<header-name>
TTS_API_MODEL=
TTS_API_VOICE=
TTS_API_FORMAT=<audio-format>
TTS_API_METHOD=<http-method>
TTS_API_SPEED=<speed>
TTS_API_VOICES_URL=
TTS_API_APP_ID=
TTS_API_APP_SECRET=
TTS_API_BASE_ID=
TTS_API_EXTRA_JSON=

# Existing independent VoxCPM2 installation (no automatic dependency/model installation)
# SHORT_VIDEO_VOXCPM2_DIR=/absolute/path/to/voxcpm2-local
# SHORT_VIDEO_VOXCPM2_SEED=42
# SHORT_VIDEO_VOXCPM2_STEPS=10
# SHORT_VIDEO_WHISPER_MODEL=/absolute/path/to/existing/small.pt

# Volcengine v1 timestamp units: tested large-model frontend returns ms.
# VOLCENGINE_TTS_TIMESTAMP_UNIT=ms

# Optional: existing local MLX Whisper directory/Python; never auto-download.
# Personal paths may instead live in ~/.cmm/short-video-maker-local.env
# SHORT_VIDEO_MLX_WHISPER_MODEL=/existing/whisper-model
# SHORT_VIDEO_MLX_PYTHON=/existing/venv/bin/python

# Optional renderer; CLI > meta.renderEngine > environment > remotion
SHORT_VIDEO_RENDER_ENGINE=remotion
# SHORT_VIDEO_HYPERFRAMES_BIN=/absolute/path/to/hyperframes
